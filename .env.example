# Copy to .env and fill in. Never commit the real file — it's gitignored.
#
# EXPO_PUBLIC_* variables are inlined into the client bundle at build time
# and are readable by anyone with the app installed. That's an acceptable
# tradeoff for BMONI's shared sandbox key (it's published in their own docs
# and is dev-only), but a real production merchant key must never be an
# EXPO_PUBLIC_* var — route it through a server-side proxy instead. See
# docs/BMONI_INTEGRATION.md.

# 'live' wires the app to the real BMONI sandbox (embedded-dev.bmoni.com) and
# the on-device native signer. Any other value (or unset) uses the local
# simulator and never touches the network or the native module — this is the
# default so the app runs with zero setup.
EXPO_PUBLIC_BMONI_MODE=

# BMONI publishes a shared dev-only sandbox key in their own docs at
# https://bkey.mintlify.app/api-reference/introduction — paste it into your
# local .env, or request your own at https://bkey.mintlify.app/request-test-tokens.
# Deliberately not committed here even though it's public elsewhere, to keep
# this repo free of any live credential value.
EXPO_PUBLIC_BMONI_API_KEY=

# Defaults to https://embedded-dev.bmoni.com if unset.
EXPO_PUBLIC_BMONI_BASE_URL=
